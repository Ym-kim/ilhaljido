# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 시크릿·인증 파일 (커밋 금지)
*.key
secrets/
client_secret*.json
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev-media*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# browser automation snapshots
.playwright-cli/
/artifacts/

# local screenshots / images
*.png
*.jpg

# app icons are source assets
!src/app/*.png
!public/icons/*.png

# AI 생성 카드 커버는 배포 자산
!public/covers/*.jpeg
!public/covers/*.jpg
!public/covers/*.png

# 로컬 전용 인계 메모 (공개 저장소에 올리지 않음)
/HANDOFF.md
